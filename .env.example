# Скопіюйте в .env і заповніть потрібне. Усе це необов'язково:
# без ключів працює ручний режим (--provider manual) і офлайн-ембединги.

# Видача й зовнішні посилання (https://app.dataforseo.com/api-access)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Альтернативні джерела видачі (без зовнішніх посилань):
# SerpApi (https://serpapi.com/manage-api-key) - безплатно 250 пошуків на місяць, є AI Overview
SERPAPI_API_KEY=
# Serper.dev (https://serper.dev) - без AI Overview
SERPER_API_KEY=
# Можна й одним іменем SERP_API_KEY: ключ із 64 символів вважається ключем SerpApi, із 40 - ключем Serper.

# Авторитет домену, безплатно 30 000 доменів на місяць (https://keywordseverywhere.com/account/openpagerank)
OPENPAGERANK_API_KEY=

# Ембединги: достатньо одного. Без них - локальна модель (pip install fastembed) або LSA.
OPENAI_API_KEY=
GEMINI_API_KEY=

# auto | openai | gemini | local | lsa
SEOA_EMBEDDINGS=auto

# Search Console: шлях до OAuth-токена (authorized user JSON) або до ключа сервісного акаунта
GSC_TOKEN_FILE=
GSC_SERVICE_ACCOUNT_FILE=
